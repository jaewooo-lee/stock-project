# ==========================================
# Google Gemini API Key (News & YouTube Summaries)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Kakao REST API Configurations
# ==========================================
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_if_enabled

# For Flask Web App (Port 5001)
KAKAO_REDIRECT_URI_LOCAL=http://localhost:5001/oauth

# For FastAPI / Nginx Web App (Port 8000 / 80)
KAKAO_REDIRECT_URI=http://localhost:8000/api/kakao/callback
KAKAO_REFRESH_TOKEN=your_kakao_refresh_token_here

# Optional: Application Access Security Key
APP_API_KEY=

# ==========================================
# Application & Database Configurations
# ==========================================
BASE_URL=http://localhost
DATABASE_URL=sqlite:///./stock_tracker.db
REPORTS_DIR=./reports
CLEANUP_DAYS=90

